# Copy this file to .env and fill in the values. .env is in .gitignore and
# never belongs in the repository.

# ---------------------------------------------------------------------------
# Which model the app talks to
# ---------------------------------------------------------------------------
# One of the keys of PROVIDERS in src/fyndit_helper/providers.py:
#   mistral | gemini | smartapi | openai | openrouter
# The endpoint code does not change with the provider - only this line does.
LLM_PROVIDER=mistral

# The key and the model of the provider you picked. Only the pair belonging to
# LLM_PROVIDER has to be filled in; the rest can stay empty.
#
# If the model is left empty, the client uses its own default. Run
# `python scripts/list_models.py` to see what a provider currently offers.
MISTRAL_API_KEY=
MISTRAL_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

SMARTAPI_API_KEY=
SMARTAPI_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional. How much the model is allowed to reason before answering:
#   none | low | medium | high | xhigh | max
# Only the /chat/completions providers accept it; Gemini ignores it. Reasoning
# is billed as output and 'max' is roughly six times slower, which over a whole
# eval run is the difference between ten minutes and an hour. Empty = the
# provider's default.
REASONING_EFFORT=

# ---------------------------------------------------------------------------
# Access to the app
# ---------------------------------------------------------------------------
# The key that guards /ask. Without it the app starts, but /ask answers 503 -
# deliberately, so a public URL cannot spend the operator's credit at the
# provider. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# The password for the web page. It is entered once in the browser and held in
# a cookie, so the API key does not have to be typed on a phone. Without it the
# page starts but lets nobody in. Changing it logs out every device at once -
# that is the only way to take access away, because there are no accounts.
APP_PASSWORD=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Where the app stores the answers it produced. Default:
# data/history/tickets.json, which is in .gitignore.
FYNDIT_HISTORY_PATH=
