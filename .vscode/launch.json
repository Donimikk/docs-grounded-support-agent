{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fyndit Helper - server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["fyndit_helper.api:app", "--reload", "--app-dir", "src"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Fyndit Helper - server (with breakpoints)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["fyndit_helper.api:app", "--app-dir", "src"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "List available models",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/list_models.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
